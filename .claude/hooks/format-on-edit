#!/usr/bin/env bash
# PostToolUse hook matching Write|Edit|MultiEdit. Formats the edited file using
# the project's local toolchain:
#   *.{js,jsx,mjs,ts,tsx,mts}        → prettier --write + eslint --fix
#   *.{json,css,html,yml,yaml,scss}  → prettier --write
# Markdown is deliberately excluded: docs and research records are prose whose
# wrapping is the author's, and .prettierignore says the same for the
# whole-repo run. Other extensions silent no-op. Silent no-op if binaries
# missing or file gone — never blocks the edit.

set -euo pipefail

input=$(cat)
file_path=$(echo "$input" | jq -r '.tool_input.file_path // ""' 2>/dev/null || echo "")

[ -z "$file_path" ] && exit 0
[ -f "$file_path" ] || exit 0

# Only this project's own files. A sibling checkout (such as the template repo
# this one was ported from) carries files its own toolchain owns.
if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    case "$file_path" in
        "$CLAUDE_PROJECT_DIR"/*) ;;
        *) exit 0 ;;
    esac
fi

case "$file_path" in
    *.js|*.jsx|*.mjs|*.ts|*.tsx|*.mts)
        run_eslint=1; run_prettier=1 ;;
    *.json|*.css|*.html|*.yml|*.yaml|*.scss)
        run_eslint=0; run_prettier=1 ;;
    *)
        exit 0 ;;
esac

project_root="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$project_root" ]; then
    project_root=$(git -C "$(dirname "$file_path")" rev-parse --show-toplevel 2>/dev/null || echo "")
fi
[ -n "$project_root" ] || exit 0

prettier_bin="${project_root}/node_modules/.bin/prettier"
eslint_bin="${project_root}/node_modules/.bin/eslint"

if [ "$run_prettier" = "1" ] && [ -x "$prettier_bin" ]; then
    "$prettier_bin" --write --log-level error "$file_path" >/dev/null 2>&1 || true
fi

if [ "$run_eslint" = "1" ] && [ -x "$eslint_bin" ]; then
    "$eslint_bin" --fix "$file_path" >/dev/null 2>&1 || true
fi

exit 0
