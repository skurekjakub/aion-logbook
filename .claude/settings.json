{
  "//": "Project-scoped Claude Code settings (committed). User-specific overrides live in settings.local.json (gitignored).",

  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "setup-ai@giga-marketplace": true,
    "research-planning@giga-marketplace": true,
    "agent-architecture@giga-marketplace": true
  },

  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint*)",
      "Bash(pnpm game *)",
      "Bash(pnpm capture *)"
    ],
    "deny": ["Bash(npm publish*)", "Bash(pnpm publish*)", "Bash(git push --force*)"]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" project-context",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" remind-rules",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" prefer-verify-script",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" require-commit-format",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" format-on-edit",
            "async": false
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" rtk-read-compact",
            "async": false
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.cmd\" remind-rules",
            "async": false
          }
        ]
      }
    ]
  }
}
